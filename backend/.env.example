# Local dev works with NONE of these set: SQLite + fake Sarvam + default flags.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# In the cluster use Supabase (session pooler, port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LLM_MODEL=sarvam-105b
FLAGSMITH_SERVER_KEY=
FLAGSMITH_API_URL=            # self-hosted: http://localhost:8100/api/v1/ (see infra/flagsmith/README.md)
FLAGSMITH_EVENTS_URL=         # experiment events (track_event); empty -> Flagsmith Cloud events API
ALLOWED_ORIGINS=http://localhost:3000
